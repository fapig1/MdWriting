---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** 详情页没有独立导航项，用它指明归属哪个栏目，以便导航指示条停在对应位置。 */
  section?: 'main' | 'trivia';
}

const {
  title = '小事存档 · Moment Archive',
  description = '用 Markdown 收藏主线故事，也收藏那些不在计划里的支线时刻。',
  section,
} = Astro.props;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const path = Astro.url.pathname.replace(/\/$/, '');
const pageSection = path === base.replace(/\/$/, '') ? 'main' : path === `${base}trivia` ? 'trivia' : undefined;
const currentSection = pageSection ?? section;
const ariaCurrent = (name: 'main' | 'trivia') => currentSection === name ? (pageSection ? 'page' : 'true') : undefined;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到正文</a>
    <header class="site-header" transition:name="site-header" transition:animate="none">
      <a class="brand" href={base} aria-label="小事存档首页">
        <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>
        <span><strong>小事存档</strong><small>MOMENT ARCHIVE</small></span>
      </a>
      <nav class="site-nav" aria-label="主导航">
        <a href={`${base}#timeline`} aria-current={ariaCurrent('main')}>主线{currentSection === 'main' && <span class="nav-indicator" aria-hidden="true" transition:name="nav-indicator"></span>}</a>
        <a href={`${base}trivia/`} aria-current={ariaCurrent('trivia')}>支线{currentSection === 'trivia' && <span class="nav-indicator" aria-hidden="true" transition:name="nav-indicator"></span>}</a>
      </nav>
      <a class="header-note" href={`${base}#timeline`}><span></span> 持续记录中</a>
    </header>

    <main id="main-content" transition:name="page-main">
      <slot />
    </main>

    <footer class="site-footer" transition:name="site-footer" transition:animate="none">
      <div>
        <span class="footer-star" aria-hidden="true">✳</span>
        <p>日子不必惊天动地，<br />值得记住就好。</p>
      </div>
      <div class="footer-meta">
        <span>BUILT WITH MARKDOWN & ASTRO</span>
        <span>© 2026 MOMENT ARCHIVE</span>
      </div>
    </footer>
  </body>
</html>

<script>
  import type { TransitionBeforePreparationEvent, TransitionBeforeSwapEvent } from 'astro:transitions/client';

  // 主线、支线按导航顺序排成左右两页，两者互切时正文横向滑动；其他跳转保留卡片共享元素动画。
  const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
  const pageOrder = (url: URL) => {
    const path = url.pathname.replace(/\/$/, '');
    if (path === basePath) return 0;
    if (path === `${basePath}/trivia`) return 1;
    return -1;
  };

  let navDir: 'next' | 'prev' | undefined;
  let navSeq = 0;

  document.addEventListener('astro:before-preparation', (event) => {
    const { from, to } = event as TransitionBeforePreparationEvent;
    const fromIndex = pageOrder(from);
    const toIndex = pageOrder(to);
    navSeq += 1;
    navDir = fromIndex >= 0 && toIndex >= 0 && fromIndex !== toIndex ? (toIndex > fromIndex ? 'next' : 'prev') : undefined;
    // 必须在旧页面截图前写到 <html> 上。
    if (navDir) document.documentElement.dataset.navDir = navDir;
    else delete document.documentElement.dataset.navDir;
  });

  document.addEventListener('astro:before-swap', (event) => {
    if (!navDir) return;
    const { newDocument, viewTransition } = event as TransitionBeforeSwapEvent;
    // 换页时 <html> 属性会被新文档覆盖，需提前写进新文档，新页面截图和入场动画才能生效。
    newDocument.documentElement.dataset.navDir = navDir;
    newDocument.documentElement.dataset.pageEnter = '';
    const seq = navSeq;
    viewTransition.finished.finally(() => {
      if (seq === navSeq) delete document.documentElement.dataset.navDir;
    });
  });
</script>
