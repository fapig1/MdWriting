---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Timeline from '../components/Timeline.astro';
import Announcement from '../components/Announcement.astro';

const mainEvents = (await getCollection('events', ({ data }) => data.type === 'main' && !data.draft))
  .sort((a, b) => (a.data.date?.getTime() ?? 0) - (b.data.date?.getTime() ?? 0));
---

<BaseLayout>
  <section class="timeline-section home-timeline" id="timeline">
    <div class="section-heading page-width">
      <div>
        <span class="section-index">MAIN STORIES</span>
        <h2>日子排着队，<em>故事慢慢走。</em></h2>
      </div>
      <p>主线不是只有里程碑。<br />那些让后来发生改变的小事，也算。</p>
    </div>
    <Timeline events={mainEvents} />
  </section>
  <Announcement />
</BaseLayout>
