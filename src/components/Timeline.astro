---
import type { CollectionEntry } from 'astro:content';

// 只接收已按日期排序的主线事件，支线由 /trivia/ 单独渲染。
interface Props {
  events: CollectionEntry<'events'>[];
}

const { events } = Astro.props;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const formatDate = (date?: Date) => date ? date.toISOString().slice(0, 10).replaceAll('-', '.') : '';
const stemHeights = [54, 82, 66, 96, 60, 76];
---

<div class="timeline-shell">
  <div class="timeline-toolbar">
    <p><span class="mouse-icon" aria-hidden="true"></span>滚轮 / 拖拽浏览 · 点击卡片阅读全文</p>
    <div class="timeline-actions">
      <span class="timeline-count"><b id="current-event">01</b> / {String(events.length).padStart(2, '0')}</span>
      <button class="circle-button" id="timeline-prev" type="button" aria-label="向前浏览">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 5-7 7 7 7" /></svg>
      </button>
      <button class="circle-button" id="timeline-next" type="button" aria-label="向后浏览">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg>
      </button>
    </div>
  </div>

  <div class="timeline-viewport" id="timeline-scroll" tabindex="0" aria-label="主线故事横向时间轴">
    <div class="timeline-track">
      <div class="timeline-axis" aria-hidden="true"><span></span></div>
      <div class="timeline-start" aria-hidden="true">THE<br />BEGINNING</div>
      {events.map((event, index) => {
        const isTop = index % 2 === 0;
        const stem = stemHeights[index % stemHeights.length];
        return (
          <article
            class:list={["timeline-item", isTop ? 'is-top' : 'is-bottom', `accent-${event.data.accent}`]}
            style={`--stem: ${stem}px;`}
            data-event-index={index}
          >
            <div class="timeline-dot" aria-hidden="true"><span></span></div>
            <span class="timeline-stem" aria-hidden="true"></span>
            <div class="timeline-card-wrap">
              <a class="story-card" href={`${base}events/${event.id}/`} transition:name={`card-${event.id}`}>
                <div class="card-topline">
                  <span class="story-number">CH.{String(index + 1).padStart(2, '0')}</span>
                  <span class:list={["mini-tag", `tag-${event.data.accent}`]}>{event.data.tags[0]}</span>
                </div>
                <time datetime={event.data.date?.toISOString()} transition:name={`date-${event.id}`}>{formatDate(event.data.date)}</time>
                <h3 transition:name={`title-${event.id}`}>{event.data.title}</h3>
                <p>{event.data.summary}</p>
                <div class="card-bottomline">
                  <span>{event.data.location}</span>
                  <span class="card-arrow" aria-hidden="true">↗</span>
                </div>
              </a>
            </div>
          </article>
        );
      })}
      <div class="timeline-end" aria-hidden="true">
        <span>TO BE<br />CONTINUED</span><i>✳</i>
      </div>
    </div>
  </div>
  <div class="timeline-progress" aria-hidden="true"><span id="timeline-progress-bar"></span></div>
</div>

<script>
  function setupTimeline() {
    const scroller = document.getElementById('timeline-scroll');
    const prev = document.getElementById('timeline-prev');
    const next = document.getElementById('timeline-next');
    const progress = document.getElementById('timeline-progress-bar');
    const current = document.getElementById('current-event');
    if (!scroller || scroller.dataset.ready === 'true') return;
    scroller.dataset.ready = 'true';

    const update = () => {
      const max = scroller.scrollWidth - scroller.clientWidth;
      const ratio = max > 0 ? scroller.scrollLeft / max : 0;
      if (progress) progress.style.width = `${Math.max(4, ratio * 100)}%`;
      const items = Array.from(scroller.querySelectorAll<HTMLElement>('.timeline-item'));
      if (items.length && current) {
        const center = scroller.scrollLeft + scroller.clientWidth / 2;
        let nearest = 0;
        items.forEach((item, index) => {
          if (Math.abs(item.offsetLeft + item.offsetWidth / 2 - center) < Math.abs(items[nearest].offsetLeft + items[nearest].offsetWidth / 2 - center)) nearest = index;
        });
        current.textContent = String(nearest + 1).padStart(2, '0');
      }
      if (prev) (prev as HTMLButtonElement).disabled = scroller.scrollLeft < 4;
      if (next) (next as HTMLButtonElement).disabled = scroller.scrollLeft >= max - 4;
    };

    const step = () => Math.min(370, scroller.clientWidth * 0.55);
    prev?.addEventListener('click', () => scroller.scrollBy({ left: -step(), behavior: 'smooth' }));
    next?.addEventListener('click', () => scroller.scrollBy({ left: step(), behavior: 'smooth' }));
    scroller.addEventListener('scroll', update, { passive: true });
    scroller.addEventListener('wheel', (event) => {
      if (Math.abs(event.deltaY) <= Math.abs(event.deltaX)) return;
      const max = scroller.scrollWidth - scroller.clientWidth;
      const canMove = (event.deltaY > 0 && scroller.scrollLeft < max - 2) || (event.deltaY < 0 && scroller.scrollLeft > 2);
      if (canMove) {
        event.preventDefault();
        scroller.scrollLeft += event.deltaY * 1.15;
      }
    }, { passive: false });

    let dragging = false;
    let startX = 0;
    let startScroll = 0;
    scroller.addEventListener('pointerdown', (event) => {
      if (event.pointerType !== 'mouse' || (event.target as HTMLElement).closest('a')) return;
      dragging = true;
      startX = event.clientX;
      startScroll = scroller.scrollLeft;
      scroller.setPointerCapture(event.pointerId);
      scroller.classList.add('is-dragging');
    });
    scroller.addEventListener('pointermove', (event) => {
      if (dragging) scroller.scrollLeft = startScroll - (event.clientX - startX);
    });
    const stop = () => { dragging = false; scroller.classList.remove('is-dragging'); };
    scroller.addEventListener('pointerup', stop);
    scroller.addEventListener('pointercancel', stop);
    scroller.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') { event.preventDefault(); scroller.scrollBy({ left: step(), behavior: 'smooth' }); }
      if (event.key === 'ArrowLeft') { event.preventDefault(); scroller.scrollBy({ left: -step(), behavior: 'smooth' }); }
    });
    update();
  }

  document.addEventListener('astro:page-load', setupTimeline);
</script>
